# Copy this file to .env and replace the dummy values.
# .env is git-ignored and must never be committed.

# Local PostgreSQL (Docker container app-postgres).
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=r3alai
POSTGRES_USER=pipeline_user
POSTGRES_PASSWORD=change_me

# Connection string used by config.production.yaml (required, no default).
POSTGRES_DSN=postgresql://pipeline_user:change_me@localhost:5432/r3alai

# Root folder of the knowledge-base documents (optional, defaults to ./data/generated/documents).
DOCS_DIR=./data/generated/documents

# CSV export of support tickets (optional, defaults to ./data/generated/tickets/tickets_export.csv).
TICKETS_CSV=./data/generated/tickets/tickets_export.csv

# Folder containing raw .eml files (optional, defaults to ./data/generated/tickets/emails).
EML_DIR=./data/generated/tickets/emails

# Insurer name used in the training system prompt (optional, defaults to a placeholder).
INSURER_NAME=Example Insurance SA
